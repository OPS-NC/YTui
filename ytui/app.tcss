/* ytui — chassis of a late-70s hi-fi separate.
   Warm near-black, brushed-metal hairlines, amber legends, ember accents. */

Screen {
    background: #151312;
    color: #cbc0b2;
}

/* ---------------------------------------------------------------- top bar */

#topbar {
    dock: top;
    height: 1;
    background: #1e1a17;
}

#brand {
    width: auto;
    padding: 0 2;
    color: #ff6b35;
    text-style: bold;
    background: #1e1a17;
}

#status {
    width: 1fr;
    padding: 0 2;
    text-align: right;
    color: #6b6055;
    background: #1e1a17;
}

/* ----------------------------------------------------------------- search */

#search {
    margin: 1 2 0 2;
    height: 3;
    border: tall #6b4a1e;
    border-title-color: #6b6055;
    border-title-align: left;
    background: #1a1716;
    color: #f0e6d8;
}
#search:focus {
    border: tall #e09b2a;
    border-title-color: #f2b23c;
    background: #211b15;
}
#search > .input--placeholder {
    color: #554c43;
}
#search > .input--cursor {
    background: #ff6b35;
    color: #151312;
}

/* ------------------------------------------------------------------ panes */

#body {
    height: 1fr;
    padding: 1 2 0 2;
}

#left {
    width: 42%;
    margin-right: 2;
}

#right {
    width: 1fr;
}

ListView, #deck, #thumb-grid {
    background: #191615;
    border: tall #6b4a1e;
    border-title-color: #6b6055;
    border-title-align: left;
    scrollbar-size: 1 1;
    scrollbar-background: #191615;
    scrollbar-color: #443b32;
    scrollbar-color-hover: #e09b2a;
}

ListView, #thumb-grid {
    height: 1fr;
}
ListView:focus, #thumb-grid:focus {
    border: tall #e09b2a;
    border-title-color: #f2b23c;
}

/* Rows paint their own colours (see widgets.VideoItem), the CSS only
   carries the backdrop so the highlight spans the full row width. */
ListView > ListItem {
    background: #191615;
    padding: 0;
}
ListView > ListItem > Static {
    background: transparent;
    width: 1fr;
}
ListView > ListItem.-highlight,
ListView > ListItem.-highlight > Static.hl {
    background: #3b2b14;
}
ListView > ListItem.-hovered {
    background: #221c18;
}

/* The track actually playing, independent of the cursor above: ember
   instead of amber, and wins over both highlight and hover. */
ListView > ListItem.-playing,
ListView > ListItem.-playing > Static.playing {
    background: #3d2015;
}

/* ------------------------------------------------------------------- deck */

#deck {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
}

#now-title {
    height: 1;
    color: #fff6e6;
    text-style: bold;
}

#now-sub {
    height: 1;
    color: #6b6055;
    margin-bottom: 1;
}

#spectrum {
    height: 11;
    margin-bottom: 1;
}

#seek {
    height: 1;
}

/* ----------------------------------------------------------------- footer */

#bottom {
    dock: bottom;
    height: 1;
    background: #1e1a17;
}

#bottom Footer {
    dock: none;
    width: 1fr;
    height: 1;
    background: #1e1a17;
}

#mem {
    width: auto;
    height: 1;
    padding: 0 2;
    text-align: right;
    background: #1e1a17;
    color: #4f473e;
}

FooterKey {
    background: #1e1a17;
    color: #6b6055;
}
FooterKey > .footer-key--key {
    background: #1e1a17;
    color: #e09b2a;
    text-style: bold;
}
FooterKey > .footer-key--description {
    background: #1e1a17;
    color: #6b6055;
}

Toast {
    background: #221c18;
    border: tall #ff5c2e;
    color: #f0e6d8;
}

/* ------------------------------------------------------------------- clip */

#clip-layer {
    height: 1fr;
    background: #000000;
}

/* The deck panel: same slot and height as the analyser it replaces. */
#clip {
    height: 11;
    margin-bottom: 1;
}

#clip-full {
    height: 1fr;
}

/* Caption and transport sit under the picture, on the same black ground. */
#clip-title {
    height: 1;
    padding: 0 2;
    color: #fff6e6;
    text-style: bold;
    background: #000000;
}

#clip-seek {
    height: 1;
    padding: 0 2;
    background: #000000;
}
