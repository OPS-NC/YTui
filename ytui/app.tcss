/* ytui — chassis of a late-70s hi-fi separate.
   Warm near-black, brushed-metal hairlines, amber legends, ember accents. */

Screen {
    background: #0d0c0b;
    color: #cbc0b2;
}

/* ---------------------------------------------------------------- top bar */

#topbar {
    dock: top;
    height: 1;
    background: #151210;
}

#brand {
    width: auto;
    padding: 0 2;
    color: #ff6b35;
    text-style: bold;
    background: #151210;
}

#status {
    width: 1fr;
    padding: 0 2;
    text-align: right;
    color: #6b6055;
    background: #151210;
}

/* ----------------------------------------------------------------- search */

#search {
    margin: 1 2 0 2;
    height: 3;
    border: tall #2a241d;
    border-title-color: #6b6055;
    border-title-align: left;
    background: #121010;
    color: #f0e6d8;
}
#search:focus {
    border: tall #e09b2a;
    border-title-color: #f2b23c;
    background: #17130f;
}
#search > .input--placeholder {
    color: #554c43;
}
#search > .input--cursor {
    background: #ff6b35;
    color: #0d0c0b;
}

/* ------------------------------------------------------------------ panes */

#body {
    height: 1fr;
    padding: 1 2 0 2;
}

#left {
    width: 42%;
    margin-right: 2;
}

#right {
    width: 1fr;
}

ListView, #deck {
    background: #100e0d;
    border: tall #2a241d;
    border-title-color: #6b6055;
    border-title-align: left;
    scrollbar-size: 1 1;
    scrollbar-background: #100e0d;
    scrollbar-color: #3a322a;
    scrollbar-color-hover: #e09b2a;
}

ListView {
    height: 1fr;
}
ListView:focus {
    border: tall #e09b2a;
    border-title-color: #f2b23c;
}

/* Rows paint their own colours (see widgets.VideoItem), the CSS only
   carries the backdrop so the highlight spans the full row width. */
ListView > ListItem {
    background: #100e0d;
    padding: 0;
}
ListView > ListItem > Static {
    background: transparent;
    width: 1fr;
}
ListView > ListItem.-highlight,
ListView > ListItem.-highlight > Static.hl {
    background: #33240f;
}
ListView > ListItem.-hovered {
    background: #1a1512;
}

/* ------------------------------------------------------------------- deck */

#deck {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
}

#now-title {
    height: 1;
    color: #fff6e6;
    text-style: bold;
}

#now-sub {
    height: 1;
    color: #6b6055;
    margin-bottom: 1;
}

#spectrum {
    height: 11;
    margin-bottom: 1;
}

#seek {
    height: 1;
}

/* ----------------------------------------------------------------- footer */

#bottom {
    dock: bottom;
    height: 1;
    background: #151210;
}

#bottom Footer {
    dock: none;
    width: 1fr;
    height: 1;
    background: #151210;
}

#mem {
    width: auto;
    height: 1;
    padding: 0 2;
    text-align: right;
    background: #151210;
    color: #4f473e;
}

FooterKey {
    background: #151210;
    color: #6b6055;
}
FooterKey > .footer-key--key {
    background: #151210;
    color: #e09b2a;
    text-style: bold;
}
FooterKey > .footer-key--description {
    background: #151210;
    color: #6b6055;
}

Toast {
    background: #1a1512;
    border: tall #ff5c2e;
    color: #f0e6d8;
}

/* ------------------------------------------------------------------- clip */

#clip-layer {
    height: 1fr;
    background: #000000;
}

/* The deck panel: same slot and height as the analyser it replaces. */
#clip {
    height: 11;
    margin-bottom: 1;
}

#clip-full {
    height: 1fr;
}

/* Caption and transport sit under the picture, on the same black ground. */
#clip-title {
    height: 1;
    padding: 0 2;
    color: #fff6e6;
    text-style: bold;
    background: #000000;
}

#clip-seek {
    height: 1;
    padding: 0 2;
    background: #000000;
}
